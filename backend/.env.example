# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carenav_db

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-for-care-navigation-agent-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Configuration (Deterministic Mock vs Live LLM)
MOCK_AI=true
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
